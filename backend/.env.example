# Explicitly enable only for synthetic local hackathon demos.
RESQ_DEMO_MODE=true
# Required before exposing demo login beyond a trusted local network.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESQ_DEMO_ACCESS_KEY=
DATABASE_URL=sqlite:///./resq-relay.db
# Native mobile needs no CORS. Web preview requires an explicit origin:
RESQ_CORS_ORIGINS=http://localhost:8081
# PostgreSQL example (install psycopg[binary]):
# DATABASE_URL=postgresql+psycopg://resq:password@localhost:5432/resq
# SMS gateway webhook (/v1/sms/inbound?key=...). Required outside demo mode.
RESQ_SMS_SECRET=
# RESQ Assistant. Leave empty to use the offline safety guide (no AI). Never commit a real key.
ANTHROPIC_API_KEY=
RESQ_AI_MODEL=claude-opus-5-5
