# Copy to .env beside compose.yaml. Never commit the real file.
# Use a fresh random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESQ_DEMO_ACCESS_KEY=REPLACE_WITH_A_FRESH_RANDOM_KEY
# Local loopback default. For a trusted LAN-only backend set the laptop's LAN IP.
RESQ_BIND_ADDRESS=127.0.0.1
# Used only by compose.https.yaml after configuring DNS/ports on your own host:
RESQ_API_DOMAIN=api.your-domain.example
RESQ_TLS_EMAIL=you@your-domain.example
